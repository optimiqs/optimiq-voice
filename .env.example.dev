# General Notes
# -------------
#
# For development environments, you must set the following environment variables:
#
# - DOCKER_HOST_ADDRESS (Your external address)
# - ROUTR_EXTERNAL_ADDRS (Your external address)
# - ROUTR_RTPENGINE_HOST (Your external address)
# - ASTERISK_SIPPROXY_HOST (Your external address)
# - API_ROUTR_API_ENDPOINT (localhost:51907)

DOCKER_HOST_ADDRESS=/* Your external address */

# Web Settings (apps/web — the admin frontend)
# -------------------------------------------
# Replaces the legacy `dashboard` service, which is no longer part of the stack; the DASHBOARD_*
# and SERVER_DASHBOARD_SESSION_SECRET variables it used are gone with it.
#
# BOTH of these are BUILD arguments, not runtime configuration. Next evaluates rewrites() and
# inlines NEXT_PUBLIC_* during `next build`, so a change here only takes effect on
# `docker compose ... build web` — restarting the container does nothing.
#
# API_PROXY_ORIGIN is where the container forwards every /api/* request. It must name the API's
# HTTP bridge (port 9876), not its gRPC port, and keeping it same-origin from the browser's point
# of view is what makes the better-auth session cookie first-party.
API_PROXY_ORIGIN=http://api:9876
# Leave NEXT_PUBLIC_AUTH_BASE_URL empty unless the frontend is deployed apart from the API. Setting
# it makes the auth client call an absolute origin, which then also needs that origin in the API's
# trustedOrigins and cross-subdomain cookies configured.
NEXT_PUBLIC_AUTH_BASE_URL=
# The port the Next server listens on inside the container (a genuine runtime knob).
WEB_PORT=3100

# API Server Settings
# ------------------
# The owner email and password are used to create the initial administrator user.
# The server will create a new owner if the email does not exist.
# The password will be updated if the email already exists.
API_APP_URL=http://localhost:8080
API_ASTERISK_ARI_PROXY_URL=http://localhost:8088
API_ASTERISK_ARI_SECRET=changeme
API_ASTERISK_ARI_USERNAME=ari
API_CLOAK_ENCRYPTION_KEY=k1.aesgcm256.MmPSvzCG9fk654bAbl30tsqq4h9d3N4F11hlue8bGAY=
API_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optimiq-voice
API_IDENTITY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fnidentity
API_IDENTITY_ISSUER=http://optimiq-voice.local
API_IDENTITY_OAUTH2_GITHUB_CLIENT_ID=
API_IDENTITY_OAUTH2_GITHUB_CLIENT_SECRET=
API_IDENTITY_OAUTH2_GITHUB_ENABLED=false
API_IDENTITY_WORKSPACE_INVITE_FAIL_URL=http://localhost:8080/invite-fail
API_IDENTITY_WORKSPACE_INVITE_URL=http://localhost:8449/api/identity/accept-invite
API_IDENTITY_WORKSPACE_INVITE_EXPIRATION=1d
API_IDENTITY_CONTACT_VERIFICATION_REQUIRED=false
API_IDENTITY_TWO_FACTOR_AUTHENTICATION_REQUIRED=false
API_IDENTITY_PRIVATE_KEY_PATH=.keys/private.pem
API_IDENTITY_PUBLIC_KEY_PATH=.keys/public.pem
API_INFLUXDB_INIT_ORG=optimiq-voice
API_INFLUXDB_INIT_PASSWORD=changeme
API_INFLUXDB_INIT_TOKEN=ghjNQ59FW4oi3bAiMTtfMyVnqtbwq0Iib58D63Lgk3pcrEFFPT0d9tnRKzHk98HNqZJUPc_mpXVkk07_JhBhJg==
API_INFLUXDB_INIT_USERNAME=influxdb
API_INFLUXDB_URL=http://localhost:8086
API_INTEGRATIONS_FILE=./config/integrations.json
API_LOGS_FORMAT=json
