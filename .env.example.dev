# LOCAL DEVELOPMENT ONLY. EVERY SECRET BELOW IS PUBLIC.
# =====================================================
#
#   cp .env.example.dev .env
#
# The passwords and ARI secrets in this file are in version control, so they are known to
# everybody who can read the repository. They exist so `pnpm start:services` comes up without
# ceremony against containers that hold nothing real.
#
# This file ends with NODE_ENV=development, which is what switches OFF the production checks in
# `assertEnvInvariants` (`packages/config`). Point a production process at these values and it
# refuses to boot — that is the tripwire working, not a bug to route around. Deploy from
# `.env.example`, which is the production template and documents which secrets the preflight
# enforces and which it does not.
#
# For development environments, you must set the following environment variables:
#
# - DOCKER_HOST_ADDRESS (your external address)
# - ASTERISK_SIPPROXY_HOST (your external address)

DOCKER_HOST_ADDRESS=/* Your external address */

# Web Settings (apps/web — the admin frontend)
# -------------------------------------------
# BOTH of these are BUILD arguments, not runtime configuration. Next evaluates rewrites() and
# inlines NEXT_PUBLIC_* during `next build`, so a change here only takes effect on
# `docker compose ... build web` — restarting the container does nothing.
#
# API_PROXY_ORIGIN is where the container forwards every /api/* request. It must name the API's
# HTTP bridge (port 9876), and keeping it same-origin from the browser's point of view is what
# makes the better-auth session cookie first-party.
API_PROXY_ORIGIN=http://api:9876
# Leave NEXT_PUBLIC_AUTH_BASE_URL empty unless the frontend is deployed apart from the API. Setting
# it makes the auth client call an absolute origin, which then also needs that origin in the API's
# trustedOrigins and cross-subdomain cookies configured.
NEXT_PUBLIC_AUTH_BASE_URL=
# The port the Next server listens on inside the container (a genuine runtime knob).
WEB_PORT=3100

# Authentication (better-auth)
# ----------------------------
# PUBLIC. This exact string is in version control; it signs nothing that matters because nothing
# real is behind it. `.env.example` carries a placeholder the production preflight REFUSES, and
# tells you to generate the real one with `openssl rand -base64 32`.
#
# Thirty-two characters is the schema minimum in every environment, production or not, so a shorter
# "obviously fake" value would fail to parse rather than fail to protect.
AUTH_SECRET=dev-only-auth-secret-public-in-version-control
# `isAuthSliceConfigured()` is DATABASE_URL && AUTH_SECRET && AUTH_URL, and the PBX and CDR areas
# mount only alongside the auth slice — their permission guard comes from it. So this line is what
# switches the entire product surface on locally. It points at `web`, the browser-facing origin.
AUTH_URL=http://localhost:3100

# API Server Settings
# ------------------
API_APP_URL=http://localhost:3100
API_ASTERISK_ARI_PROXY_URL=http://localhost:8088
API_ASTERISK_ARI_SECRET=changeme
API_ASTERISK_ARI_USERNAME=ari
# The base database: better-auth's tables (`packages/db`). `@optimiq-voice/config` maps this onto
# the canonical DATABASE_URL, which is the name the code reads.
API_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optimiq-voice
API_LOGS_FORMAT=json
API_LOGS_LEVEL=verbose
API_LOGS_TRANSPORT=none
API_NATS_URL=nats://localhost:4222
API_OWNER_EMAIL=admin@optimiq-voice.local
API_OWNER_NAME=Admin User
API_OWNER_PASSWORD=changeme
API_ROOT_DOMAIN=optimiq-voice.local
API_SMTP_AUTH_PASS=secret
API_SMTP_AUTH_USER=postmaster@optimiq-voice.local
API_SMTP_HOST=localhost
API_SMTP_PORT=1025
API_SMTP_SECURE=false
API_SMTP_SENDER="Optimiq Voice Info <info@optimiq-voice.local>"

# Telephony databases (the PBX and CDR bounded contexts)
# -----------------------------------------------------
# Separate databases from API_DATABASE_URL, deliberately. Each area is skipped entirely when its
# variable is absent — silently, by design — so an incomplete .env gives you an API that boots,
# answers /api/auth/*, and 404s every PBX and reporting route.
#
# `pnpm db:migrate` creates and migrates all three.
PBX_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optimiq_pbx
CDR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optimiq_cdr
# The one object store, and a RELATIVE path on purpose: in development apps/api runs on the HOST
# (`pnpm start:api`), while Asterisk runs in a container that bind-mounts this same directory
# read-only as /var/lib/optimiq/objects (see compose.dev.yaml). The two agreeing is what makes a
# prompt uploaded in the admin UI actually play on a call.
CDR_RECORDING_ROOT=./.media
# PUBLIC. Signs recording and voicemail playback URLs; at least 32 characters.
CDR_RECORDING_URL_SECRET=dev-only-recording-url-secret-public-in-vcs

# The object store
# ----------------
# `local` is the default and is what you want unless you are specifically exercising the S3 path:
# the ./.media directory above IS the store, and it is the directory Asterisk bind-mounts.
#
# To try the S3 driver, bring up the `minio` service (it is NOT part of `pnpm start:services`):
#
#   docker compose -f compose.yaml -f compose.dev.yaml up minio -d
#   docker compose -f compose.yaml -f compose.dev.yaml exec minio \
#     mc alias set local http://localhost:9000 minioadmin minioadmin
#   docker compose -f compose.yaml -f compose.dev.yaml exec minio mc mb --ignore-existing local/optimiq-media
#
# then set STORAGE_DRIVER=s3 below and restart `pnpm start:api`. The console is on
# http://localhost:9001 (minioadmin / minioadmin) — upload a prompt in the admin UI and the object
# should appear BOTH under ./.media and in the bucket. That is the point: the filesystem copy is
# what Asterisk plays (ARI takes a path, not a URL), and the bucket copy is what survives the
# container. See apps/api/src/storage/object-store.ts.
STORAGE_DRIVER=local
S3_BUCKET=optimiq-media
# MinIO ignores the region and the SDK's signer requires one.
S3_REGION=us-east-1
# `localhost` because apps/api runs on the HOST in development (`pnpm start:api`), like every other
# service URL in this file. From inside a container it would be http://minio:9000.
S3_ENDPOINT=http://localhost:9000
# PUBLIC dev credentials — MinIO's root user IS the access key. These match the compose service's
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD defaults; override both together if you change either.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Derived from S3_ENDPOINT being set, so this is here for visibility rather than because MinIO
# needs it spelled out. MinIO cannot do virtual-host addressing without wildcard DNS.
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Mail Delivery
# -------------
# The canonical (unprefixed) names; each falls back to its API_SMTP_* counterpart above. Pointed at
# the mailhog container `pnpm start:services` brings up — SMTP on 1025, the web UI on 8025 — so a
# local sign-up, invitation or voicemail notification is a real message you can open in a browser.
#
# Delete SMTP_HOST (or unset it) to get the logging fallback instead: every message is rendered and
# written to the API's log, one-time links included. Both modes are supported locally; only
# production refuses to boot without a relay.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Mailhog accepts unauthenticated submission. Both halves must be present for AUTH to be attempted
# at all, so leaving them empty is "no auth" rather than a failed handshake.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Optimiq Voice <no-reply@optimiq-voice.local>"
MAIL_REPLY_TO=
# The web app, for the links inside a message (the voicemail inbox, the invitation accept page).
MAIL_APP_URL=http://localhost:3100
SMTP_TIMEOUT_MS=10000

# Message Broker (NATS)
# ---------------------
# PUBLIC, and required: the broker runs from `config/nats.conf`, which defines an OPTIMIQ account
# for the platform services and a $SYS account for operators, and nats-server resolves these four
# names out of its own environment. Leave any of them unset and `pnpm start:services` brings up a
# `nats` container that exits immediately with "variable reference ... can not be found".
#
# NATS_USER / NATS_PASS are also what the host-side processes read — `pnpm start:api`, the engine,
# sipd and the operational scripts all connect with them.
#
# NATS_URL is set alongside API_NATS_URL and is NOT redundant: the PBX and CDR areas parse
# `process.env` at their own boundary and read the unprefixed name, and the CDR area REQUIRES it.
NATS_URL=nats://localhost:4222
NATS_USER=optimiq
NATS_PASS=optimiq-dev-broker-password
NATS_SYS_USER=optimiq-sys
NATS_SYS_PASS=optimiq-dev-system-password

# Asterisk Settings
# ----------------
ASTERISK_ARI_PROXY_URL=http://localhost:8088
ASTERISK_ARI_SECRET=changeme
ASTERISK_ARI_USERNAME=ari
ASTERISK_CODECS=g722,ulaw,alaw
ASTERISK_DTMF_MODE=auto_info
ASTERISK_RTP_PORT_END=20000
ASTERISK_RTP_PORT_START=10000
ASTERISK_SIPPROXY_HOST=/* Your external address */
ASTERISK_SIPPROXY_PORT=5060
ASTERISK_SIPPROXY_SECRET=changeme
ASTERISK_SIPPROXY_USERNAME=voice

# Call Engine (apps/engine)
# ------------------------
# Two registrable extensions (1001 / 1002) with static credentials, so the routing slice can be
# driven from a softphone without a provisioning layer. Development only.
ENGINE_ARI_APP=optimiq-engine
ENGINE_PORT=4010
ENGINE_ROUTING_ENABLED=true
OPTIMIQ_DEV_ENDPOINTS=true
# Leave empty and the engine REJECTS inbound calls with INVALID_PROFILE, which is correct for a box
# nobody has assigned. Set it to a local organization id to accept them single-tenant.
OPTIMIQ_DEV_ORG_ID=

# Database Security Configuration
# -----------------------------
# For production environments, we recommend using a managed database service.
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

NODE_ENV=development
