{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"noEmit": false
	},
	"include": ["src/**/*"],
	// `*.fake.ts` is spec scaffolding that lives next to the contract it fakes (the same rule
	// `packages/routing` applies to `fixtures.ts`): compiled by the tooling project so the specs
	// typecheck, never shipped in `dist`.
	"exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.fake.ts", "test/**/*"]
}
