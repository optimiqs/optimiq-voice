{
  "name": "@optimiq-voice/autopilot",
  "version": "0.22.3",
  "description": "Voice AI for the Optimiq Voice platform",
  "license": "MIT",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json",
    "clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo",
    "generate:readme": "node ../../.scripts/gen-readme.cjs",
    "start:dev": "nodemon --exec tsx --watch src src/server.ts"
  },
  "files": [
    "dist",
    "silero_vad.onnx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimiqs/optimiq-voice.git"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.999.0",
    "@dmitryrechkin/json-schema-to-zod": "1.0.1",
    "@optimiq-voice/common": "workspace:^",
    "@optimiq-voice/logger": "workspace:^",
    "@optimiq-voice/sdk": "workspace:^",
    "@optimiq-voice/types": "workspace:^",
    "@optimiq-voice/voice": "workspace:^",
    "@langchain/anthropic": "1.3.21",
    "@langchain/community": "1.1.20",
    "@langchain/core": "1.1.49",
    "@langchain/google-genai": "2.1.21",
    "@langchain/groq": "1.1.3",
    "@langchain/ollama": "1.2.7",
    "@langchain/openai": "1.2.11",
    "@langchain/textsplitters": "1.0.1",
    "cheerio": "1.2.0",
    "dotenv": "16.6.1",
    "js-yaml": "4.1.1",
    "langchain": "1.2.28",
    "moment": "2.30.1",
    "onnxruntime-node": "1.21.1",
    "openai": "4.104.0",
    "pdf-parse": "2.4.5",
    "uuid": "11.1.1",
    "xstate": "5.17.3",
    "zod": "3.25.76"
  }
}
