{
	"name": "@optimiq-voice/mcp",
	"version": "0.22.3",
	"description": "Model Context Protocol for Optimiq Voice",
	"license": "MIT",
	"main": "dist/index",
	"types": "dist/index",
	"bin": {
		"optimiq-voice-mcp": "./dist/index.js"
	},
	"directories": {
		"src": "src",
		"test": "test"
	},
	"scripts": {
		"prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
		"build": "tsc -b tsconfig.json",
		"postbuild": "chmod +x ./dist/index.js",
		"clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo",
		"start:dev": "nodemon --exec tsx --watch src src/index.ts"
	},
	"dependencies": {
		"@optimiq-voice/common": "workspace:^",
		"@optimiq-voice/logger": "workspace:^",
		"@optimiq-voice/sdk": "workspace:^",
		"@modelcontextprotocol/sdk": "1.27.1"
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	}
}
