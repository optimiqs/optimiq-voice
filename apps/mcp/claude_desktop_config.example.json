{
	"mcpServers": {
		"optimiq-voice": {
			"command": "npx",
			"args": ["-y", "@optimiq-voice/mcp"],
			"env": {
				"MCP_WORKSPACE_ACCESS_KEY_ID": "your-workspace-access-key-id",
				"MCP_APIKEY_ACCESS_KEY_ID": "your-apikey-access-key-id",
				"MCP_APIKEY_ACCESS_KEY_SECRET": "your-apikey-access-key-secret"
			}
		}
	}
}
