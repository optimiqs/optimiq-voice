# apps/web — Optimiq Voice admin frontend
#
# Copy to apps/web/.env.local for local development. The API's own configuration lives in the
# repository-root .env (DATABASE_URL, AUTH_SECRET, AUTH_URL, API_APP_URL) and is read by
# @optimiq-voice/config — this file only configures the Next.js app.

# --- Server-side (not exposed to the browser) -------------------------------------------------

# Where next.config.mjs proxies every /api/* request. Point it at apps/api.
# Keeping the browser on one origin is what makes the better-auth session cookie first-party:
# no CORS preflight, no SameSite=None, no cross-site cookie blocking.
#
# IMPORTANT — this is a BUILD-TIME variable for `next start`. Next evaluates rewrites() during
# `next build` and bakes the destination into .next/routes-manifest.json; `next start` never calls
# the function again, so changing this afterwards has no effect on a production server. It must be
# set for the build. `next dev` re-evaluates it on every boot.
API_PROXY_ORIGIN=http://127.0.0.1:50051

# --- Client-side (inlined into the bundle — never put a secret in a NEXT_PUBLIC_ variable) -----

# The better-auth client's base URL. Leave unset in development: it defaults to the same-origin
# path /api/auth, which the rewrite above forwards. Set it to an absolute origin ONLY when the
# frontend is deployed separately from the API — that deployment then also needs the API's
# trustedOrigins to include this app's origin and cross-subdomain cookies configured.
# NEXT_PUBLIC_AUTH_BASE_URL=https://api.example.com/api/auth

# --- Matching API configuration (set these in the ROOT .env, not here) -------------------------
#
#   DATABASE_URL=postgresql://optimiq:optimiq@localhost:5433/optimiq
#   AUTH_SECRET=<at least 32 characters>
#     Note: the jwt plugin stores its JWKS private key in the database encrypted with this value.
#     Changing it against an existing database makes session resolution fail with
#     "Failed to decrypt private key" — every /api/v1/* route then answers 401 while /api/auth/*
#     keeps working. Rotate the secret and the jwks table together.
#   AUTH_URL=http://127.0.0.1:50051          # the API's own origin
#   API_APP_URL=http://localhost:3100        # this app; invitation and reset links point here,
#                                            # and it must be a trusted origin for better-auth
