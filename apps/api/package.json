{
	"name": "@optimiq-voice/api",
	"version": "0.22.3",
	"description": "API for Optimiq Voice",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"directories": {
		"src": "src",
		"test": "test"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
		"db:deploy": "node scripts/db-provision.mjs",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"emit:sip-vectors": "tsx scripts/emit-sip-derivation-vectors.ts",
		"generate:musiconhold": "tsx scripts/generate-musiconhold.ts",
		"prebuild": "rimraf ./dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
		"rebuild:did-index": "tsx scripts/rebuild-did-index.ts",
		"rebuild:queue-membership": "tsx scripts/rebuild-queue-membership.ts",
		"seed:cdr": "tsx scripts/seed-cdr-demo.ts",
		"seed:pbx": "tsx scripts/seed-pbx-demo.ts",
		"start:dev": "nodemon --exec tsx --watch src src/main.ts",
		"test": "cross-env LOG_LEVEL=silent LOG_PRETTY=false NODE_ENV=development mocha \"test/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict.json --noEmit",
		"verify:auth": "tsx scripts/verify-auth-slice.ts",
		"verify:call-token": "tsx scripts/verify-call-token.ts",
		"verify:carrier": "tsx scripts/verify-carrier.ts",
		"verify:cdr": "tsx scripts/verify-cdr.ts",
		"verify:live": "tsx scripts/verify-live.ts",
		"verify:media": "tsx scripts/verify-media.ts",
		"verify:pbx": "tsx scripts/verify-pbx.ts",
		"verify:provisioning": "tsx scripts/verify-provisioning.ts",
		"verify:sip-credentials": "tsx scripts/verify-sip-credentials.ts",
		"verify:voicemail": "tsx scripts/verify-voicemail.ts"
	},
	"bin": {
		"optimiq-voice": "./dist/index.js"
	},
	"dependencies": {
		"@fastify/multipart": "catalog:",
		"@nestjs/common": "11.1.28",
		"@nestjs/core": "11.1.28",
		"@nestjs/microservices": "catalog:",
		"@nestjs/platform-fastify": "11.1.28",
		"@optimiq-voice/auth": "workspace:*",
		"@optimiq-voice/cdr-db": "workspace:*",
		"@optimiq-voice/config": "workspace:*",
		"@optimiq-voice/db": "workspace:*",
		"@optimiq-voice/effect-runtime": "workspace:*",
		"@optimiq-voice/events": "workspace:*",
		"@optimiq-voice/identifiers": "workspace:*",
		"@optimiq-voice/logging": "workspace:*",
		"@optimiq-voice/pbx-db": "workspace:*",
		"@optimiq-voice/routing": "workspace:*",
		"@optimiq-voice/telnyx": "workspace:*",
		"better-auth": "catalog:",
		"dotenv": "16.6.1",
		"drizzle-orm": "catalog:",
		"effect": "catalog:",
		"fastify": "catalog:",
		"jose": "catalog:",
		"nats": "2.29.3",
		"nodemailer": "9.0.4",
		"pg": "8.22.0",
		"postgres": "catalog:",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"ws": "8.21.2",
		"zod": "3.25.76"
	},
	"files": [
		"dist",
		"drizzle",
		"migrations",
		"scripts"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"devDependencies": {
		"@types/nodemailer": "8.0.1",
		"@types/ws": "8.18.1",
		"cross-env": "7.0.3",
		"drizzle-kit": "catalog:",
		"mocha": "11.7.6",
		"tsx": "4.22.4"
	}
}
