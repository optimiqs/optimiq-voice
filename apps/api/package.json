{
	"name": "@optimiq-voice/api",
	"version": "0.22.3",
	"description": "API for Optimiq Voice",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"directories": {
		"src": "src",
		"test": "test"
	},
	"scripts": {
		"backfill:tenancy": "tsx scripts/backfill-tenancy-organization-id.ts",
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
		"db:deploy": "node scripts/db-provision.mjs",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"migrate:identity": "tsx scripts/migrate-identity-to-organizations.ts",
		"prebuild": "rimraf ./dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
		"pretest": "bash ../../.scripts/gen-keypair.sh",
		"seed:pbx": "tsx scripts/seed-pbx-demo.ts",
		"start:dev": "nodemon --exec tsx --watch src src/main.ts",
		"test": "cross-env LOGS_LEVEL=none NODE_ENV=development API_IDENTITY_PRIVATE_KEY_PATH=.keys/private.pem API_IDENTITY_PUBLIC_KEY_PATH=.keys/public.pem mocha \"test/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict.json --noEmit",
		"verify:auth": "tsx scripts/verify-auth-slice.ts",
		"verify:call-token": "tsx scripts/verify-call-token.ts",
		"verify:identity-migration": "tsx scripts/verify-identity-migration.ts",
		"verify:pbx": "tsx scripts/verify-pbx.ts",
		"verify:tenancy": "tsx scripts/verify-tenancy-backfill.ts"
	},
	"bin": {
		"optimiq-voice": "./dist/index.js"
	},
	"dependencies": {
		"@47ng/cloak": "1.2.0",
		"@deepgram/sdk": "3.13.0",
		"@google-cloud/speech": "6.7.1",
		"@google-cloud/text-to-speech": "5.8.1",
		"@grpc/grpc-js": "1.10.12",
		"@influxdata/influxdb-client": "1.35.0",
		"@nestjs/common": "11.1.28",
		"@nestjs/core": "11.1.28",
		"@nestjs/microservices": "catalog:",
		"@nestjs/platform-fastify": "11.1.28",
		"@optimiq-voice/auth": "workspace:*",
		"@optimiq-voice/authz": "workspace:^",
		"@optimiq-voice/autopilot": "workspace:^",
		"@optimiq-voice/common": "workspace:^",
		"@optimiq-voice/config": "workspace:*",
		"@optimiq-voice/db": "workspace:*",
		"@optimiq-voice/effect-runtime": "workspace:*",
		"@optimiq-voice/events": "workspace:*",
		"@optimiq-voice/identifiers": "workspace:*",
		"@optimiq-voice/identity": "workspace:^",
		"@optimiq-voice/logger": "workspace:^",
		"@optimiq-voice/pbx-db": "workspace:*",
		"@optimiq-voice/routing": "workspace:*",
		"@optimiq-voice/sipnet": "workspace:^",
		"@optimiq-voice/streams": "workspace:^",
		"@optimiq-voice/types": "workspace:^",
		"@routr/common": "2.13.20",
		"@routr/sdk": "2.13.20",
		"ari-client": "2.2.0",
		"better-auth": "catalog:",
		"dotenv": "16.6.1",
		"drizzle-orm": "catalog:",
		"effect": "catalog:",
		"elevenlabs": "1.59.0",
		"grpc-health-check": "2.1.0",
		"jose": "catalog:",
		"jsonwebtoken": "9.0.3",
		"jwt-decode": "4.0.0",
		"microsoft-cognitiveservices-speech-sdk": "1.50.0",
		"nanoid": "3.3.12",
		"nats": "2.29.3",
		"pb-util": "1.0.3",
		"pg": "8.22.0",
		"pick-port": "2.2.0",
		"postgres": "catalog:",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"uuid": "11.1.1",
		"validator": "13.15.26",
		"wait-port": "1.1.0",
		"wavefile": "11.0.0",
		"zod": "3.25.76",
		"zod-validation-error": "3.5.4"
	},
	"files": [
		"dist",
		"drizzle",
		"migrations",
		"scripts"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"devDependencies": {
		"@optimiq-voice/voice": "workspace:^",
		"@types/ari-client": "2.2.13",
		"@types/jsonwebtoken": "9.0.10",
		"@types/uuid": "10.0.0",
		"@types/validator": "13.15.10",
		"cross-env": "7.0.3",
		"drizzle-kit": "catalog:",
		"mocha": "11.7.6",
		"tsx": "4.22.4"
	}
}
