{
  "name": "@optimiq-voice/api",
  "version": "0.22.3",
  "description": "API for Optimiq Voice",
  "license": "MIT",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json",
    "clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo",
    "db:deploy": "node scripts/db-provision.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "start:dev": "nodemon --exec tsx --watch src src/main.ts"
  },
  "bin": {
    "optimiq-voice": "./dist/index.js"
  },
  "dependencies": {
    "@47ng/cloak": "1.2.0",
    "@deepgram/sdk": "3.13.0",
    "@optimiq-voice/authz": "workspace:^",
    "@optimiq-voice/autopilot": "workspace:^",
    "@optimiq-voice/common": "workspace:^",
    "@optimiq-voice/identity": "workspace:^",
    "@optimiq-voice/logger": "workspace:^",
    "@optimiq-voice/sipnet": "workspace:^",
    "@optimiq-voice/streams": "workspace:^",
    "@optimiq-voice/types": "workspace:^",
    "@google-cloud/speech": "6.7.1",
    "@google-cloud/text-to-speech": "5.8.1",
    "@grpc/grpc-js": "1.10.12",
    "@influxdata/influxdb-client": "1.35.0",
    "@routr/common": "2.13.20",
    "@routr/sdk": "2.13.20",
    "ari-client": "2.2.0",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "elevenlabs": "1.59.0",
    "grpc-health-check": "2.1.0",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "4.0.0",
    "microsoft-cognitiveservices-speech-sdk": "1.50.0",
    "nanoid": "3.3.12",
    "nats": "2.29.3",
    "pb-util": "1.0.3",
    "pg": "8.22.0",
    "pick-port": "2.2.0",
    "uuid": "11.1.1",
    "validator": "13.15.26",
    "wait-port": "1.1.0",
    "wavefile": "11.0.0",
    "zod": "3.25.76",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "effect": "4.0.0-beta.103",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod-validation-error": "3.5.4"
  },
  "files": [
    "dist",
    "drizzle",
    "migrations",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimiqs/optimiq-voice.git"
  },
  "devDependencies": {
    "@types/ari-client": "2.2.13",
    "@types/jsonwebtoken": "9.0.10",
    "@types/uuid": "10.0.0",
    "@types/validator": "13.15.10",
    "drizzle-kit": "0.31.10"
  }
}
