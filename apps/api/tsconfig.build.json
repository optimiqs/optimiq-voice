{
	// The emitting project. `module: "preserve"` (inherited from tsconfig.base.json) leaves
	// relative specifiers extension-less in the emitted JS, which Node's ESM resolver rejects, so
	// `build` runs `.scripts/rewrite-esm-specifiers.mjs` over `dist` afterwards — the same two-step
	// build every package in the repository uses.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "./src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
