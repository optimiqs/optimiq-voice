# Git files
.git
.gitignore
.github

# Documentation
*.md
README.md
CONTRIBUTING.md
LICENSE

# Node modules (will be installed in container)
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store

# Build artifacts (will be built in container)
**/dist
**/.nyc_output
**/coverage
**/build
**/tsconfig.tsbuildinfo
# Next.js and turbo caches. apps/web/.next alone is hundreds of megabytes after a local build, and
# shipping it into the context would also let a stale local build shadow the one made in the image.
**/.next
**/.turbo
**/.react-router

# Test files
**/test
**/tests
**/__tests__
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# Development files
.env
.env.*
!.env.example
**/.env
**/.env.*
**/!.env.example

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# CI/CD
.github

# Docker files (BuildKit reads the selected Dockerfile separately)
**/Dockerfile
**/.dockerignore

# Other unnecessary files
apps/site
assets
*.log
*.tgz
*.tar.gz

# Config files that aren't needed in build
.keys
config/*.json
!config/integrations.example.json

# Compose files
compose*.yaml
docker-compose*.yml

# Scripts (needed for build)
# .scripts - keep this, needed for postbuild
scripts

# Misc
.nyc_output
coverage
*.map
.eslintcache
