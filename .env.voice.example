# Native SIP/media stack. Copy to .env.voice and replace all CHANGE_ME values.
# Keep this file private. Generate a DIFFERENT random value for every secret.
VOICE_IMAGE_TAG=local
WEB_PORT=3100
API_APP_URL=https://voice.example.com
AUTH_URL=https://voice.example.com
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_OWNER_PASSWORD
# Three separate databases, created only when the Postgres volume is empty.
# Runtime logins need database grants; PBX/CDR require BYPASSRLS plus their tenant-role membership.
# See docs/native-calling-deployment.md before starting the API.
API_DATABASE_URL=postgresql://voice_api:CHANGE_ME_API_DB_PASSWORD@postgres:5432/optimiq_voice
PBX_DATABASE_URL=postgresql://voice_pbx:CHANGE_ME_PBX_DB_PASSWORD@postgres:5432/optimiq_pbx
CDR_DATABASE_URL=postgresql://voice_cdr:CHANGE_ME_CDR_DB_PASSWORD@postgres:5432/optimiq_cdr
DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME_DATABASE_OWNER_PASSWORD@postgres:5432/optimiq_voice
PBX_DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME_DATABASE_OWNER_PASSWORD@postgres:5432/optimiq_pbx
CDR_DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME_DATABASE_OWNER_PASSWORD@postgres:5432/optimiq_cdr
DATABASE_DEPLOYMENT_STAGE=production
# Set to apply only for an intentional production migration invocation.
DATABASE_MIGRATION_CONFIRM_PRODUCTION=
API_NATS_URL=nats://nats:4222
NATS_URL=nats://nats:4222
NATS_USER=operator
NATS_PASS=CHANGE_ME_OPERATOR_PASSWORD
NATS_SYS_USER=system
NATS_SYS_PASS=CHANGE_ME_SYSTEM_PASSWORD
NATS_API_USER=api
NATS_API_PASS=CHANGE_ME_API_PASSWORD
NATS_ENGINE_USER=engine
NATS_ENGINE_PASS=CHANGE_ME_ENGINE_PASSWORD
NATS_SIPD_USER=sipd
NATS_SIPD_PASS=CHANGE_ME_SIP_PASSWORD
NATS_MEDIAD_USER=mediad
NATS_MEDIAD_PASS=CHANGE_ME_MEDIA_PASSWORD
SIPD_REALM=sip.example.com
SIPD_NONCE_SECRET=CHANGE_ME_SHARED_NONCE_SECRET
SIPD_TRUNK_ACL=
MEDIAD_PUBLIC_IP=203.0.113.10
PROVISION_SIP_SECRET_KEY=CHANGE_ME_PROVISIONING_SECRET
PROVISION_BASE_URL=https://voice.example.com
CDR_RECORDING_URL_SECRET=CHANGE_ME_RECORDING_URL_SECRET
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM=Optimiq Voice <voice@example.com>
# TLS files on the Linux deployment host; the certificate covers the SIP and TURN names.
#
# NOT `./config/certs`: that directory is the output of `config/certs/generate-dev-certs.sh`, a
# self-signed CA trusted only by this checkout, and it is gitignored as disposable — a developer
# running that script would overwrite a production key put there. The compose files still default to
# it when this is unset, which is the right default for a development box and the wrong one for a
# template that also carries the real chain's paths below.
VOICE_CERTS_DIR=/etc/optimiq/certs
SIPD_TLS=true
SIPD_WSS=true
SIPD_TLS_CERT_FILE=/etc/optimiq/certs/fullchain.pem
SIPD_TLS_KEY_FILE=/etc/optimiq/certs/privkey.pem
MEDIAD_WEBRTC=true
PROVISION_SIP_WSS_URL=wss://sip.example.com:8089
PROVISION_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PROVISION_TURN_SECRET=CHANGE_ME_TURN_SECRET
PROVISION_TURN_TTL_SECONDS=3600
VOICE_TURN_CONFIG=./config/turn/turnserver.conf
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_SIP_REGION=us
TELNYX_WEBHOOK_URL=https://voice.example.com/api/v1/carrier/webhooks/telnyx
