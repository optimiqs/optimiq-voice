{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"orgId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"sdpOffer": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"direction": {
			"default": "sendrecv",
			"type": "string",
			"enum": ["sendrecv", "sendonly", "recvonly", "inactive"]
		}
	},
	"required": ["sessionId", "orgId", "callId", "sdpOffer", "direction"],
	"additionalProperties": false
}
