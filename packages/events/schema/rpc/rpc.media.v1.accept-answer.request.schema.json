{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"sdpAnswer": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"srtpPolicy": {
			"type": "string",
			"enum": ["prefer", "require", "disable"]
		}
	},
	"required": ["sessionId", "sdpAnswer"],
	"additionalProperties": false
}
