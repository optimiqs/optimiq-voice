{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"orgId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"trunkId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"secretRef": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"username": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"realm": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255
		},
		"algorithm": {
			"type": "string",
			"enum": ["MD5", "SHA-256", "SHA-512-256"]
		}
	},
	"required": ["orgId", "trunkId", "secretRef", "username", "realm", "algorithm"],
	"additionalProperties": false
}
