{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ok": {
			"type": "boolean"
		},
		"orgId": {
			"type": "string",
			"maxLength": 128
		},
		"trunkId": {
			"type": "string",
			"maxLength": 128
		},
		"username": {
			"type": "string",
			"maxLength": 128
		},
		"realm": {
			"type": "string",
			"maxLength": 255
		},
		"algorithm": {
			"type": "string",
			"enum": ["MD5", "SHA-256", "SHA-512-256"]
		},
		"ha1": {
			"type": "string",
			"pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{64})$"
		},
		"reason": {
			"type": "string",
			"maxLength": 256
		}
	},
	"required": ["ok"],
	"additionalProperties": false
}
