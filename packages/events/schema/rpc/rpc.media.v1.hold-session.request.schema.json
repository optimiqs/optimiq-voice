{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"unhold": {
			"default": false,
			"type": "boolean"
		},
		"music": {
			"type": "string",
			"minLength": 1,
			"maxLength": 512
		},
		"musicRef": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		}
	},
	"required": ["sessionId", "unhold"],
	"additionalProperties": false
}
