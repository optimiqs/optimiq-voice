{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"applied": {
			"type": "boolean"
		},
		"kind": {
			"type": "string",
			"enum": ["unavailable", "busy", "name", "temporary"]
		},
		"active": {
			"default": false,
			"type": "boolean"
		},
		"greetingId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"objectKey": {
			"type": "string",
			"maxLength": 1024
		},
		"reason": {
			"type": "string",
			"maxLength": 256
		}
	},
	"required": ["applied", "kind", "active"],
	"additionalProperties": false
}
