{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"recordingRef": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"direction": {
			"default": "both",
			"type": "string",
			"enum": ["receive", "both"]
		},
		"format": {
			"default": "wav",
			"type": "string",
			"enum": ["wav"]
		},
		"maxDurationMs": {
			"type": "integer",
			"minimum": 1000,
			"maximum": 14400000
		},
		"maxSilenceMs": {
			"type": "integer",
			"minimum": 500,
			"maximum": 3600000
		},
		"beep": {
			"type": "boolean"
		},
		"terminateOn": {
			"type": "string",
			"maxLength": 16
		}
	},
	"required": ["sessionId", "recordingRef", "direction", "format"],
	"additionalProperties": false
}
