{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"status": {
			"default": 180,
			"type": "integer",
			"minimum": 180,
			"maximum": 183
		},
		"sdpAnswer": {
			"type": "string",
			"maxLength": 16384
		}
	},
	"required": ["legId", "status"],
	"additionalProperties": false
}
