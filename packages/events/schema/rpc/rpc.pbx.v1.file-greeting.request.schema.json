{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"orgId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"voicemailBoxId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"mailboxNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32
		},
		"greetingId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"kind": {
			"default": "unavailable",
			"type": "string",
			"enum": ["unavailable", "busy", "name", "temporary"]
		},
		"objectKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"recordingId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"durationMs": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"callId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		}
	},
	"required": [
		"orgId",
		"voicemailBoxId",
		"mailboxNumber",
		"greetingId",
		"kind",
		"objectKey",
		"durationMs"
	],
	"additionalProperties": false
}
