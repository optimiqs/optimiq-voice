{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"orgId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"parkLotId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"slot": {
			"type": "integer",
			"minimum": 0,
			"maximum": 1000000
		},
		"mediaChannelId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"retrieverInstanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"retrieverMediaChannelId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"retrieverLegId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"bridgeId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		}
	},
	"required": [
		"orgId",
		"parkLotId",
		"slot",
		"mediaChannelId",
		"retrieverInstanceId",
		"retrieverMediaChannelId",
		"retrieverLegId",
		"bridgeId"
	],
	"additionalProperties": false
}
