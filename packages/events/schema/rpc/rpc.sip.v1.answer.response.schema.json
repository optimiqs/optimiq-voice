{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ok": {
			"type": "boolean"
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": [
				"bad_request",
				"unknown_dialog",
				"wrong_instance",
				"dialog_gone",
				"invalid_state",
				"unregistered_target",
				"unknown_trunk",
				"no_route",
				"capacity",
				"shutting_down",
				"not_supported",
				"internal"
			]
		},
		"error": {
			"type": "string",
			"maxLength": 512
		},
		"sentAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
		}
	},
	"required": ["ok", "legId"],
	"additionalProperties": false
}
