{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"orgId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"originateId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"fromExtension": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"to": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"ringTimeoutSeconds": {
			"type": "integer",
			"minimum": 5,
			"maximum": 300
		},
		"callerIdNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callerIdName": {
			"type": "string",
			"maxLength": 128
		},
		"requestedBy": {
			"type": "string",
			"maxLength": 128
		}
	},
	"required": ["orgId", "originateId", "fromExtension", "to"],
	"additionalProperties": false
}
