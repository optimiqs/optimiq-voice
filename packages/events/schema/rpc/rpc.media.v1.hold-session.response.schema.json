{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ok": {
			"type": "boolean"
		},
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"held": {
			"default": false,
			"type": "boolean"
		},
		"musicRef": {
			"type": "string",
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": [
				"bad_request",
				"capacity",
				"shutting_down",
				"unknown_session",
				"wrong_instance",
				"not_supported",
				"internal"
			]
		},
		"error": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": ["ok", "sessionId", "held"],
	"additionalProperties": false
}
