{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ok": {
			"type": "boolean"
		},
		"bridgeId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"sessionIds": {
			"default": [],
			"maxItems": 8,
			"type": "array",
			"items": {
				"type": "string",
				"maxLength": 128
			}
		},
		"mixed": {
			"default": false,
			"type": "boolean"
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": [
				"bad_request",
				"capacity",
				"shutting_down",
				"unknown_session",
				"wrong_instance",
				"not_supported",
				"internal"
			]
		},
		"error": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": ["ok", "bridgeId", "sessionIds", "mixed"],
	"additionalProperties": false
}
