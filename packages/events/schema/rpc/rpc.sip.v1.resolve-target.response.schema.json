{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"contacts": {
			"maxItems": 20,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"requestUri": {
						"type": "string",
						"minLength": 1,
						"maxLength": 1024
					},
					"transport": {
						"type": "string",
						"enum": ["udp", "tcp", "tls", "ws", "wss"]
					},
					"instanceId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"q": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					}
				},
				"required": ["requestUri", "transport", "instanceId", "q"],
				"additionalProperties": false
			}
		},
		"ok": {
			"type": "boolean"
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": [
				"bad_request",
				"unknown_dialog",
				"wrong_instance",
				"dialog_gone",
				"invalid_state",
				"unregistered_target",
				"unknown_trunk",
				"no_route",
				"capacity",
				"shutting_down",
				"not_supported",
				"internal"
			]
		},
		"error": {
			"type": "string",
			"maxLength": 512
		},
		"requestUri": {
			"type": "string",
			"maxLength": 1024
		},
		"transport": {
			"type": "string",
			"enum": ["udp", "tcp", "tls", "ws", "wss"]
		}
	},
	"required": ["ok", "legId"],
	"additionalProperties": false
}
