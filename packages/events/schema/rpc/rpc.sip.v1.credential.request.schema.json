{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"realm": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255
		},
		"username": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"sourceAddress": {
			"type": "string",
			"maxLength": 64
		},
		"transport": {
			"type": "string",
			"enum": [
				"udp",
				"tcp",
				"tls",
				"ws",
				"wss"
			]
		}
	},
	"required": [
		"realm",
		"username"
	],
	"additionalProperties": false
}
