{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"ok": {
			"type": "boolean"
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"orgId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"routingContext": {
			"type": "string",
			"maxLength": 64
		},
		"direction": {
			"type": "string",
			"enum": ["inbound", "outbound", "internal"]
		},
		"reason": {
			"type": "string",
			"enum": [
				"unattributed",
				"unknown_target",
				"not_permitted",
				"congestion",
				"shutting_down",
				"bad_request",
				"internal"
			]
		},
		"error": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": ["ok", "legId"],
	"additionalProperties": false
}
