{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"callerNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"attempts": {
			"type": "integer",
			"minimum": 1,
			"maximum": 10
		},
		"dropped": {
			"type": "boolean"
		},
		"reason": {
			"type": "string",
			"maxLength": 64
		}
	},
	"required": ["callerNumber", "attempts", "dropped"],
	"additionalProperties": false
}
