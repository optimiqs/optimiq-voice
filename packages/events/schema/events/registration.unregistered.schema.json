{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"aor": {
			"type": "string",
			"minLength": 3,
			"maxLength": 256
		},
		"aorHash": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"contact": {
			"type": "string",
			"minLength": 3,
			"maxLength": 512
		},
		"transport": {
			"type": "string",
			"enum": [
				"udp",
				"tcp",
				"tls",
				"ws",
				"wss"
			]
		},
		"userAgent": {
			"type": "string",
			"maxLength": 256
		},
		"sourceAddress": {
			"type": "string",
			"maxLength": 64
		},
		"deviceId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"extensionId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"reason": {
			"type": "string",
			"enum": [
				"client",
				"admin",
				"replaced",
				"gateway-down"
			]
		}
	},
	"required": [
		"aor",
		"aorHash",
		"contact",
		"transport"
	],
	"additionalProperties": false
}
