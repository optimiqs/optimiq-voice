{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"digit": {
			"type": "string",
			"pattern": "^[0-9A-D*#]$"
		},
		"durationMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		}
	},
	"required": ["sessionId", "instanceId", "digit", "durationMs"],
	"additionalProperties": false
}
