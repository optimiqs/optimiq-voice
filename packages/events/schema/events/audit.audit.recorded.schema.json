{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"actor": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"user",
						"api-key",
						"service",
						"system"
					]
				},
				"id": {
					"type": "string",
					"maxLength": 128
				},
				"label": {
					"type": "string",
					"maxLength": 256
				},
				"ip": {
					"type": "string",
					"maxLength": 64
				},
				"userAgent": {
					"type": "string",
					"maxLength": 512
				}
			},
			"required": [
				"type"
			],
			"additionalProperties": false
		},
		"action": {
			"type": "string",
			"minLength": 1,
			"maxLength": 96,
			"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
		},
		"resource": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[a-z][a-z0-9-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 128
				},
				"label": {
					"type": "string",
					"maxLength": 256
				}
			},
			"required": [
				"type"
			],
			"additionalProperties": false
		},
		"outcome": {
			"type": "string",
			"enum": [
				"allowed",
				"denied",
				"failed"
			]
		},
		"requestId": {
			"type": "string",
			"maxLength": 128
		},
		"changes": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"from": {},
					"to": {}
				},
				"additionalProperties": false
			}
		},
		"reason": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": [
		"actor",
		"action",
		"resource",
		"outcome"
	],
	"additionalProperties": false
}
