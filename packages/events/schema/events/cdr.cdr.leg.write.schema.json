{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
		},
		"callId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"leg": {
			"type": "string",
			"enum": ["a", "b"]
		},
		"originatingLegId": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				},
				{
					"type": "null"
				}
			]
		},
		"bridgeLegId": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				},
				{
					"type": "null"
				}
			]
		},
		"direction": {
			"type": "string",
			"enum": ["inbound", "outbound", "internal"]
		},
		"fromNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"fromName": {
			"anyOf": [
				{
					"type": "string",
					"maxLength": 128
				},
				{
					"type": "null"
				}
			]
		},
		"toNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"destinationType": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32,
			"pattern": "^[a-z][a-z_-]*$"
		},
		"destinationRef": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				},
				{
					"type": "null"
				}
			]
		},
		"startedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
		},
		"answeredAt": {
			"anyOf": [
				{
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
				},
				{
					"type": "null"
				}
			]
		},
		"endedAt": {
			"anyOf": [
				{
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
				},
				{
					"type": "null"
				}
			]
		},
		"durationMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"billsecMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"hangupCause": {
			"type": "string",
			"minLength": 1,
			"maxLength": 48,
			"pattern": "^[A-Z][A-Z0-9_]*$"
		},
		"hangupCauseCode": {
			"type": "integer",
			"minimum": 0,
			"maximum": 1023
		},
		"hangupSide": {
			"anyOf": [
				{
					"type": "string",
					"enum": ["caller", "callee", "system"]
				},
				{
					"type": "null"
				}
			]
		},
		"disposition": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32,
			"pattern": "^[a-z][a-z-]*$"
		},
		"queueRef": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				},
				{
					"type": "null"
				}
			]
		},
		"queueWaitMs": {
			"anyOf": [
				{
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				{
					"type": "null"
				}
			]
		},
		"queueOutcome": {
			"anyOf": [
				{
					"type": "string",
					"enum": ["answered", "caller-hangup", "timeout", "overflow", "no-agents", "exit-key"]
				},
				{
					"type": "null"
				}
			]
		},
		"queueAgentRef": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": [
		"id",
		"callId",
		"leg",
		"direction",
		"fromNumber",
		"toNumber",
		"destinationType",
		"startedAt",
		"durationMs",
		"billsecMs",
		"hangupCause",
		"hangupCauseCode",
		"disposition"
	],
	"additionalProperties": {}
}
