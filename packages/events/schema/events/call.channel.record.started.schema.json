{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"recordingId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"objectKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"kind": {
			"type": "string",
			"enum": ["call", "voicemail", "conference"]
		},
		"stereo": {
			"type": "boolean"
		},
		"consent": {
			"type": "object",
			"properties": {
				"outcome": {
					"type": "string",
					"enum": ["not-required", "announced", "accepted", "declined"]
				},
				"method": {
					"type": "string",
					"enum": ["none", "announcement", "keypress"]
				},
				"policy": {
					"type": "string",
					"enum": ["none", "announce", "announce-and-require-keypress"]
				},
				"at": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
				},
				"parties": {
					"maxItems": 4,
					"type": "array",
					"items": {
						"type": "string",
						"enum": ["caller", "callee"]
					}
				},
				"regions": {
					"maxItems": 16,
					"type": "array",
					"items": {
						"type": "string",
						"maxLength": 16
					}
				},
				"promptId": {
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
				}
			},
			"required": ["outcome", "method", "policy", "at", "parties"],
			"additionalProperties": false
		}
	},
	"required": ["legId", "recordingId", "objectKey", "kind"],
	"additionalProperties": false
}
