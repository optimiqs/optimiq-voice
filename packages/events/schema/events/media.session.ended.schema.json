{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"rtpPort": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65534
		},
		"packetsReceived": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"packetsSent": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"reason": {
			"type": "string",
			"enum": ["released", "rtp-timeout", "idle-reaped", "drained", "error"]
		},
		"durationMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"detail": {
			"type": "string",
			"maxLength": 512
		},
		"quality": {
			"type": "object",
			"properties": {
				"inboundJitterMs": {
					"type": "number",
					"minimum": 0
				},
				"reportedLossFraction": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"reportedLossTotal": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"reportedJitterMs": {
					"type": "number",
					"minimum": 0
				},
				"roundTripMs": {
					"type": "number",
					"minimum": 0
				},
				"reportsReceived": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"reportsSent": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"malformed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"lastReportUnixMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"inboundJitterMs",
				"reportedLossFraction",
				"reportedLossTotal",
				"reportedJitterMs",
				"roundTripMs",
				"reportsReceived",
				"reportsSent",
				"malformed",
				"lastReportUnixMs"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"sessionId",
		"instanceId",
		"rtpPort",
		"packetsReceived",
		"packetsSent",
		"reason",
		"durationMs"
	],
	"additionalProperties": false
}
