{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"rtpPort": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65534
		},
		"packetsReceived": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"packetsSent": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"reason": {
			"type": "string",
			"enum": ["released", "rtp-timeout", "idle-reaped", "drained", "error"]
		},
		"durationMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"detail": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": [
		"sessionId",
		"instanceId",
		"rtpPort",
		"packetsReceived",
		"packetsSent",
		"reason",
		"durationMs"
	],
	"additionalProperties": false
}
