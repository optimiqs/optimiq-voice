{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"recordingRef": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": ["stopped", "max-duration", "max-silence", "session-ended", "error"]
		},
		"durationMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"bytes": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"objectKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"direction": {
			"type": "string",
			"enum": ["receive", "both"]
		},
		"detail": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": [
		"sessionId",
		"instanceId",
		"recordingRef",
		"reason",
		"durationMs",
		"bytes",
		"objectKey",
		"direction"
	],
	"additionalProperties": false
}
