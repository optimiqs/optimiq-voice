{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"role": {
			"type": "string",
			"enum": ["uas", "uac"]
		},
		"identity": {
			"type": "object",
			"properties": {
				"sipCallId": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"localTag": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"remoteTag": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				}
			},
			"required": ["sipCallId"],
			"additionalProperties": false
		},
		"sdpAnswer": {
			"type": "string",
			"maxLength": 16384
		},
		"setupMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		}
	},
	"required": ["legId", "callId", "instanceId", "role", "identity"],
	"additionalProperties": false
}
