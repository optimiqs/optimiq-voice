{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"dialed": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"number": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callerNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callerName": {
			"type": "string",
			"maxLength": 128
		},
		"elin": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"emergencyAddressId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"trunkName": {
			"type": "string",
			"maxLength": 128
		}
	},
	"required": ["legId", "dialed", "number"],
	"additionalProperties": false
}
