{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"leg": {
			"type": "string",
			"enum": [
				"a",
				"b"
			]
		},
		"direction": {
			"type": "string",
			"enum": [
				"inbound",
				"outbound",
				"internal"
			]
		},
		"from": {
			"type": "object",
			"properties": {
				"number": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"name": {
					"type": "string",
					"maxLength": 128
				}
			},
			"required": [
				"number"
			],
			"additionalProperties": false
		},
		"to": {
			"type": "object",
			"properties": {
				"number": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				}
			},
			"required": [
				"number"
			],
			"additionalProperties": false
		},
		"originatingLegId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"sipCallId": {
			"type": "string",
			"maxLength": 256
		},
		"routingContext": {
			"type": "string",
			"maxLength": 64
		},
		"remoteAddress": {
			"type": "string",
			"maxLength": 64
		}
	},
	"required": [
		"legId",
		"leg",
		"direction",
		"from",
		"to"
	],
	"additionalProperties": false
}
