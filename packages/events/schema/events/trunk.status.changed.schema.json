{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"status": {
			"type": "string",
			"enum": ["unknown", "up", "down", "degraded", "disabled"]
		},
		"reason": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"latencyMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 3600000
		},
		"endpoint": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		}
	},
	"required": ["status"],
	"additionalProperties": false
}
