{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"sessionId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"callId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"legId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"playbackRef": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"reason": {
			"type": "string",
			"enum": ["completed", "stopped", "error"]
		},
		"playedMs": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"detail": {
			"type": "string",
			"maxLength": 512
		}
	},
	"required": ["sessionId", "instanceId", "playbackRef", "reason", "playedMs"],
	"additionalProperties": false
}
