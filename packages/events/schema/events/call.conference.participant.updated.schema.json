{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"conferenceId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"roomNumber": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"muted": {
			"type": "boolean"
		},
		"deafened": {
			"type": "boolean"
		},
		"moderator": {
			"type": "boolean"
		},
		"talkGainPercent": {
			"type": "integer",
			"minimum": 0,
			"maximum": 400
		},
		"listenGainPercent": {
			"type": "integer",
			"minimum": 0,
			"maximum": 400
		},
		"byUserId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		}
	},
	"required": [
		"legId",
		"conferenceId",
		"roomNumber",
		"muted",
		"deafened",
		"moderator",
		"talkGainPercent",
		"listenGainPercent"
	],
	"additionalProperties": false
}
