{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"legId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"pagingGroupId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"pagingGroupName": {
			"type": "string",
			"maxLength": 128
		},
		"dialed": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"pagerExtension": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"memberCount": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"answeredCount": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"oneWay": {
			"type": "boolean"
		}
	},
	"required": [
		"legId",
		"pagingGroupId",
		"pagingGroupName",
		"memberCount",
		"answeredCount",
		"oneWay"
	],
	"additionalProperties": false
}
