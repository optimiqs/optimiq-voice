{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"instanceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"startedAt": {
			"type": "number"
		},
		"renewedAt": {
			"type": "number"
		},
		"expiresAt": {
			"type": "number"
		},
		"channels": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		}
	},
	"required": ["instanceId", "startedAt", "renewedAt", "expiresAt"],
	"additionalProperties": {}
}
