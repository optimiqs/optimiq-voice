{
	"name": "@optimiq-voice/events",
	"version": "0.1.0",
	"description": "NATS backbone contract package for Optimiq Voice: versioned subject taxonomy, Zod event schemas, and JetStream stream / KV bucket definitions as declarative config",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./schemas": {
			"types": "./src/schemas/index.ts",
			"default": "./dist/schemas/index.js"
		},
		"./streams": {
			"types": "./src/streams.ts",
			"default": "./dist/streams.js"
		},
		"./subjects": {
			"types": "./src/subjects.ts",
			"default": "./dist/subjects.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist",
		"codegen": "tsx scripts/generate-go.ts",
		"codegen:check": "tsx scripts/generate-go.ts && ./scripts/check-drift.sh",
		"test": "bun test src",
		"test:integration": "RUN_NATS_INTEGRATION_TESTS=true bun test src --max-concurrency 1",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@optimiq-voice/identifiers": "workspace:*",
		"nats": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"tsx": "^4.23.7",
		"typescript": "^5.9.3"
	}
}
