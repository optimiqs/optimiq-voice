{
  "name": "@optimiq-voice/sdk",
  "version": "0.22.3",
  "description": "Web and Node.js SDK for Optimiq Voice",
  "license": "MIT",
  "main": "dist/node/node.js",
  "module": "dist/node/index.esm.js",
  "browser": "dist/web/index.esm.js",
  "unpkg": "dist/web/optimiq-voice.min.js",
  "types": "dist/node/node.d.ts",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "rollup -c rollup.config.mjs && tsc --project tsconfig.json",
    "postbuild": "mv dist/node/src/* dist/node && rm -rf dist/node/generated && cp -a src/generated dist/node/generated/ && cp dist/web/optimiq-voice.min.js public/optimiq-voice.min.js",
    "clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo",
    "generate:readme": "node ../../.scripts/gen-readme.cjs",
    "start:demo": "pnpm exec serve -s public -l 9000",
    "start:oauth2-demo": "pnpm exec serve public -l 9000"
  },
  "keywords": [
    "sdk",
    "optimiq-voice"
  ],
  "dependencies": {
    "@optimiq-voice/common": "workspace:^",
    "@optimiq-voice/types": "workspace:^",
    "@grpc/grpc-js": "1.10.12",
    "@grpc/proto-loader": "0.7.15",
    "google-protobuf": "3.21.4",
    "grpc-web": "1.5.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimiqs/optimiq-voice.git"
  },
  "devDependencies": {
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/google-protobuf": "3.15.12",
    "@types/mustache": "4.2.6",
    "@web/dev-server-esbuild": "1.0.5",
    "@web/test-runner": "0.18.3",
    "@web/test-runner-playwright": "0.11.1",
    "mustache": "4.2.0",
    "rollup": "4.59.0",
    "serve": "14.2.6"
  }
}
