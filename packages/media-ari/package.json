{
	"name": "@optimiq-voice/media-ari",
	"version": "0.1.0",
	"description": "Typed Asterisk 22 ARI adapter for Optimiq Voice: REST resources, the event WebSocket and the discriminated event union. Protocol only — no domain logic, no NATS, no telephony imports",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist",
		"test": "bun test src",
		"test:integration": "RUN_ARI_INTEGRATION_TESTS=true bun test src --max-concurrency 1",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "^5.9.3"
	}
}
