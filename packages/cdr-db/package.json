{
	"name": "@optimiq-voice/cdr-db",
	"version": "0.1.0",
	"description": "CDR/reporting bounded-context database for Optimiq Voice: partitioned per-leg call records, call events, recordings metadata, hangup-cause taxonomy and the cdr tenant role",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./src/schema/index.ts",
			"default": "./dist/schema/index.js"
		}
	},
	"files": [
		"dist",
		"drizzle"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist",
		"db:check": "drizzle-kit check --config drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "bun run scripts/migrate.ts --expected-stage development",
		"db:migrate:production": "bun run scripts/migrate.ts --expected-stage production",
		"db:migrate:staging": "bun run scripts/migrate.ts --expected-stage staging",
		"db:migrate:test": "bun run scripts/migrate.ts --expected-stage test",
		"db:partitions:ensure": "bun run scripts/ensure-partitions.ts",
		"db:preflight:tenant-rls": "bun run scripts/tenant-rls-preflight.ts",
		"db:retention": "bun run scripts/retention.ts",
		"test": "bun test src",
		"test:integration": "RUN_DB_INTEGRATION_TESTS=true bun test src --max-concurrency 1",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@optimiq-voice/db": "workspace:*",
		"@optimiq-voice/identifiers": "workspace:*",
		"drizzle-orm": "catalog:",
		"postgres": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "^5.9.3"
	}
}
