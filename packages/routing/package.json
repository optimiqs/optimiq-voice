{
	"name": "@optimiq-voice/routing",
	"version": "0.1.0",
	"description": "The routing compiler for Optimiq Voice: turns a tenant's PBX configuration snapshot into a deterministic, cacheable runtime routing artifact, and resolves inbound / internal / outbound calls against it",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist",
		"test": "bun test src",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@optimiq-voice/telephony": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "^5.9.3"
	}
}
