{
	"name": "@optimiq-voice/identity-client",
	"version": "0.22.0",
	"description": "Lightweight client for the Optimiq Voice Identity gRPC service",
	"license": "MIT",
	"main": "dist/index",
	"types": "dist/index",
	"scripts": {
		"prebuild": "rimraf ./dist tsconfig.tsbuildinfo && node scripts/sync-proto.mjs",
		"build": "tsc -p tsconfig.json",
		"clean": "rimraf ./dist node_modules tsconfig.tsbuildinfo proto"
	},
	"dependencies": {
		"@grpc/grpc-js": "1.10.12",
		"@grpc/proto-loader": "0.7.15",
		"jsonwebtoken": "9.0.3"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "20.19.35",
		"rimraf": "5.0.10",
		"typescript": "^5.9.0"
	},
	"files": [
		"dist",
		"proto"
	]
}
