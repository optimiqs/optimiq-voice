{
	"name": "@optimiq-voice/telephony",
	"version": "0.1.0",
	"description": "Pure call-domain package for Optimiq Voice: channel/call state machines, device-state aggregation, hangup-cause taxonomy, bridge modes, session-protocol verbs, DTMF and the channel event vocabulary",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/optimiqs/optimiq-voice.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../.scripts/rewrite-esm-specifiers.mjs",
		"clean": "rimraf ./dist",
		"test": "bun test src",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "^5.9.3"
	}
}
