# THIS FILE IS A TEMPLATE. IT CONTAINS NO USABLE CREDENTIALS.
# =========================================================
#
# Every secret below is a placeholder. This file ends with NODE_ENV=production, and
# `@optimiq-voice/config` runs `assertEnvInvariants` at import time, so a process started from an
# unedited copy of this file does not boot — it throws before it can answer a call. That is
# deliberate: the placeholders are the tripwire.
#
# Copy it, replace every value in the two lists below, and keep the result out of version control:
#
#   cp .env.example .env
#
# For local development use `.env.example.dev` instead — it is the same shape with throwaway values
# and NODE_ENV=development, which switches these production checks off.
#
# Addresses you must set
# ----------------------
# Each of these ships as the `/* ... */` marker, which the boot preflight refuses in production.
# Set them to an address every endpoint can reach: the public IP of the server in a cloud
# deployment, the LAN address of the host locally.
#
# - ROUTR_EXTERNAL_ADDRS
# - ROUTR_RTPENGINE_HOST
# - ASTERISK_SIPPROXY_HOST
# - RTPENGINE_PUBLIC_IP
#
# Secrets the boot preflight REFUSES in production
# ------------------------------------------------
# Generate each one independently (`openssl rand -base64 32`). Leaving any of them at the shipped
# placeholder aborts startup with `<KEY> still uses the .env.example placeholder value.`
#
# - API_ASTERISK_ARI_SECRET        (must equal ASTERISK_ARI_SECRET)
# - ASTERISK_ARI_SECRET
# - ASTERISK_SIPPROXY_SECRET
# - API_OWNER_PASSWORD
# - API_INFLUXDB_INIT_PASSWORD     (must equal INFLUXDB_INIT_PASSWORD)
# - INFLUXDB_INIT_PASSWORD
# - POSTGRES_PASSWORD
# - API_CLOAK_ENCRYPTION_KEY
#
# Secrets the boot preflight does NOT check — you are on your own
# ---------------------------------------------------------------
# These carry placeholders too, but nothing refuses to start if you forget them. Treat this list
# as a manual checklist until the preflight grows to cover it.
#
# - AUTH_SECRET                    (not in this file at all; production requires >=32 characters)
# - API_INFLUXDB_INIT_TOKEN        (must equal INFLUXDB_INIT_TOKEN)
# - INFLUXDB_INIT_TOKEN
# - API_DATABASE_URL               (embeds the Postgres password)
# - API_IDENTITY_DATABASE_URL      (embeds the Postgres password)
# - ROUTR_DATABASE_URL             (embeds the Postgres password)
# - SMTP_PASS / API_SMTP_AUTH_PASS
# - API_TWILIO_AUTH_TOKEN, AUTOPILOT_* keys, AUTOPILOT_AWS_S3_SECRET_ACCESS_KEY
#
# Do not "tidy" the placeholder strings in the enforced list above. The literal values are what
# `PLACEHOLDER_SECRETS` in `packages/config/src/env-invariants.ts` matches; renaming one here
# without adding it there turns a loud startup failure into a deployment running on a public
# password.

# Web Settings (apps/web — the admin frontend)
# -------------------------------------------
# Replaces the legacy `dashboard` service, which is no longer part of the stack.
#
# API_PROXY_ORIGIN and NEXT_PUBLIC_AUTH_BASE_URL are BUILD arguments, not runtime configuration:
# Next evaluates rewrites() and inlines NEXT_PUBLIC_* during `next build`, so changing either only
# takes effect on a rebuild of the image. They are read by compose.dev.yaml's `build.args`; the
# shipped image already defaults API_PROXY_ORIGIN to the `api` service.
#
# API_PROXY_ORIGIN must name the API's HTTP bridge (port 9876), not its gRPC port. Every /api/*
# request the browser makes is forwarded there by the web container, which is what keeps the
# better-auth session cookie first-party.
API_PROXY_ORIGIN=http://api:9876
# Leave empty unless the frontend is deployed apart from the API. Setting it makes the auth client
# call an absolute origin, which then also needs that origin in the API's trustedOrigins and
# cross-subdomain cookies configured.
NEXT_PUBLIC_AUTH_BASE_URL=
# The port the Next server listens on inside the container. This one IS read at runtime.
WEB_PORT=3100

# API Server Settings
# ------------------
# The owner email and password are used to create the initial administrator user.
# The server will create a new owner if the email does not exist.
# The password will be updated if the email already exists.
API_APP_URL=http://localhost:8080
API_ASTERISK_ARI_PROXY_URL=http://asterisk:8088
API_ASTERISK_ARI_SECRET=changeme
API_ASTERISK_ARI_USERNAME=ari
API_AUTHZ_SERVICE_ENABLED=false
API_AUTHZ_SERVICE_HOST=fnauthz
API_AUTHZ_SERVICE_METHODS=/optimiq_voice.calls.v1beta2.Calls/CreateCall,/optimiq_voice.identity.v1beta2.Identity/CreateWorkspace
API_AUTHZ_SERVICE_PORT=50071
API_CLOAK_ENCRYPTION_KEY=k1.aesgcm256.MmPSvzCG9fk654bAbl30tsqq4h9d3N4F11hlue8bGAY=
API_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/optimiq-voice
API_IDENTITY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fnidentity
API_IDENTITY_ISSUER=http://optimiq-voice.local
API_IDENTITY_OAUTH2_GITHUB_CLIENT_ID=
API_IDENTITY_OAUTH2_GITHUB_CLIENT_SECRET=
API_IDENTITY_OAUTH2_GITHUB_ENABLED=false
API_IDENTITY_WORKSPACE_INVITE_FAIL_URL=http://localhost:8080/invite-fail
API_IDENTITY_WORKSPACE_INVITE_URL=http://localhost:8449/api/identity/accept-invite
API_IDENTITY_WORKSPACE_INVITE_EXPIRATION=1d
API_IDENTITY_CONTACT_VERIFICATION_REQUIRED=false
API_IDENTITY_TWO_FACTOR_AUTHENTICATION_REQUIRED=false
API_INFLUXDB_INIT_ORG=optimiq-voice
API_INFLUXDB_INIT_PASSWORD=changeme
# NOT checked by the boot preflight, and it looks like a generated token because InfluxDB tokens
# look like that — it is a placeholder. Generate your own and keep it equal to INFLUXDB_INIT_TOKEN.
API_INFLUXDB_INIT_TOKEN=replace-with-a-generated-influxdb-admin-token
API_INFLUXDB_INIT_USERNAME=influxdb
API_INFLUXDB_URL=http://influxdb:8086
API_LOGS_FORMAT=json
API_LOGS_LEVEL=verbose
API_LOGS_TRANSPORT=none
API_NATS_URL=nats://nats:4222
API_OWNER_EMAIL=admin@optimiq-voice.local
API_OWNER_NAME=Admin User
API_OWNER_PASSWORD=changeme
API_ROOT_DOMAIN=optimiq-voice.local
API_SMTP_AUTH_PASS=secret
API_SMTP_AUTH_USER=postmaster@optimiq-voice.local
API_SMTP_HOST=your-smtp-server
API_SMTP_PORT=587
API_SMTP_SECURE=true
API_SMTP_SENDER="Optimiq Voice Info <info@optimiq-voice.local>"
API_SIGNALING_SERVER=ws://localhost:5062

# Mail Delivery
# -------------
# These are the CANONICAL names. They are unprefixed because mail is a platform capability rather
# than an apps/api feature, and each one falls back to its legacy API_SMTP_* counterpart above, so
# a deployment that only sets those keeps working:
#
#   SMTP_HOST -> API_SMTP_HOST          SMTP_USER -> API_SMTP_AUTH_USER
#   SMTP_PORT -> API_SMTP_PORT          SMTP_PASS -> API_SMTP_AUTH_PASS
#   SMTP_SECURE -> API_SMTP_SECURE      MAIL_FROM -> API_SMTP_SENDER
#   MAIL_APP_URL -> API_APP_URL
#
# WITHOUT SMTP_HOST and MAIL_FROM the API renders every message — email verification, password
# reset, organization invitations, two-factor codes and voicemail notifications — and writes it to
# the log INSTEAD OF SENDING IT, one-time links included. That is a development affordance: a
# NODE_ENV=production process refuses to boot in that state rather than leaking links to a log
# aggregator.
#
# SMTP_SECURE is implicit TLS (SMTPS). Leave it unset and it is derived from the port: 465 is
# implicit TLS, anything else is STARTTLS.
SMTP_HOST=your-smtp-server
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=postmaster@optimiq-voice.local
SMTP_PASS=secret
# The envelope sender. A bare address or "Name <address>". No default: a guessed From address
# produces mail a receiving domain rejects for a reason nothing in the process can see.
MAIL_FROM="Optimiq Voice <no-reply@optimiq-voice.local>"
# Optional Reply-To, for a deployment whose MAIL_FROM is an unmonitored mailbox.
MAIL_REPLY_TO=
# Where a link inside a message points — the web app, not the API. Defaults to API_APP_URL.
MAIL_APP_URL=
# Connection/greeting/socket timeout for the relay, in milliseconds.
SMTP_TIMEOUT_MS=10000
API_TWILIO_ACCOUNT_SID=
API_TWILIO_AUTH_TOKEN=
API_TWILIO_PHONE_NUMBER=

# Autopilot Settings
# -----------------
# The Knowledge Base feature requires an S3-compatible storage service.
# OpenAI API and Unstructured API keys are also required to enable this feature.
#
# The Knowledge Base feature is disabled by default due to its multiple integrations.
# Please consult the documentation for details on how to enable it.
AUTOPILOT_AWS_S3_ACCESS_KEY_ID=
AUTOPILOT_AWS_S3_ENDPOINT=
AUTOPILOT_AWS_S3_REGION=us-east-1
AUTOPILOT_AWS_S3_SECRET_ACCESS_KEY=
AUTOPILOT_CONVERSATION_PROVIDER=api
AUTOPILOT_INTEGRATIONS_FILE=/opt/optimiq-voice/integrations.json
AUTOPILOT_KNOWLEDGE_BASE_ENABLED=false
AUTOPILOT_LOGS_FORMAT=none
AUTOPILOT_LOGS_LEVEL=verbose
AUTOPILOT_LOGS_TRANSPORT=none
AUTOPILOT_OPENAI_API_KEY=
AUTOPILOT_UNSTRUCTURED_API_KEY=
AUTOPILOT_UNSTRUCTURED_API_URL=

# Routr Settings
# -------------
# The external address must be configured to an address accessible by all endpoints.
# For local network deployments, this is typically your router's public IP address.
# For cloud deployments, this is typically the public IP address of your cloud instance.
ROUTR_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/routr
ROUTR_EXTERNAL_ADDRS=/* Set to the IP address of the host */
ROUTR_LOGS_FORMAT=none
ROUTR_LOGS_LEVEL=verbose
ROUTR_LOGS_TRANSPORT=none
ROUTR_NATS_PUBLISHER_ENABLED=true
ROUTR_NATS_PUBLISHER_URL=nats://nats:4222
ROUTR_RTPENGINE_HOST=rtpengine

# Asterisk Settings
# ----------------
# Note: Set ASTERISK_SIPPROXY_HOST to the same value as ROUTR_EXTERNAL_ADDRS
ASTERISK_ARI_PROXY_URL=http://asterisk:8088
ASTERISK_ARI_SECRET=changeme
ASTERISK_ARI_USERNAME=ari
ASTERISK_CODECS=g722,ulaw,alaw
ASTERISK_DTMF_MODE=auto_info
ASTERISK_RTP_PORT_END=20000
ASTERISK_RTP_PORT_START=10000
ASTERISK_SIPPROXY_HOST=/* Set to the IP address of the host */
ASTERISK_SIPPROXY_PORT=5060
ASTERISK_SIPPROXY_SECRET=changeme
ASTERISK_SIPPROXY_USERNAME=voice

# RTP Engine Settings
# ------------------
# Set RTPENGINE_PUBLIC_IP to the same value as ROUTR_EXTERNAL_ADDRS
# Adjust RTPENGINE_PORT_MIN and RTPENGINE_PORT_MAX to define the range for media traffic.
RTPENGINE_PORT_MAX=20000
RTPENGINE_PORT_MIN=10000
RTPENGINE_PUBLIC_IP=/* Set to the IP address of the host */

# InfluxDB Settings
# ----------------
INFLUXDB_INIT_ORG=optimiq-voice
# Refused in production while it reads `changeme`. Must equal API_INFLUXDB_INIT_PASSWORD.
INFLUXDB_INIT_PASSWORD=changeme
# NOT checked by the boot preflight. Must equal API_INFLUXDB_INIT_TOKEN.
INFLUXDB_INIT_TOKEN=replace-with-a-generated-influxdb-admin-token
INFLUXDB_INIT_USERNAME=influxdb

# Database Security Configuration
# -----------------------------
# For production environments, we recommend using a managed database service
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

NODE_ENV=production
