# THIS FILE IS A TEMPLATE. IT CONTAINS NO USABLE CREDENTIALS.
# =========================================================
#
# Every secret below is a placeholder. This file ends with NODE_ENV=production, and
# `@optimiq-voice/config` runs `assertEnvInvariants` at import time, so a process started from an
# unedited copy of this file does not boot — it throws before it can answer a call. That is
# deliberate: the placeholders are the tripwire.
#
# Copy it, replace every value in the two lists below, and keep the result out of version control:
#
#   cp .env.example .env
#
# For local development use `.env.example.dev` instead — it is the same shape with throwaway values
# and NODE_ENV=development, which switches these production checks off.
#
# Addresses you must set
# ----------------------
# Ships as the `/* ... */` marker, which the boot preflight refuses in production. Set it to an
# address every endpoint can reach: the public IP of the server in a cloud deployment, the LAN
# address of the host locally.
#
# - ASTERISK_SIPPROXY_HOST
#
# Secrets the boot preflight REFUSES in production
# ------------------------------------------------
# Generate each one independently (`openssl rand -base64 32`). Leaving any of them at the shipped
# placeholder aborts startup with `<KEY> still uses the .env.example placeholder value.`
#
# - AUTH_SECRET                    (also required to be >=32 characters)
# - API_ASTERISK_ARI_SECRET        (must equal ASTERISK_ARI_SECRET)
# - ASTERISK_ARI_SECRET
# - ASTERISK_SIPPROXY_SECRET
# - API_OWNER_PASSWORD
# - POSTGRES_PASSWORD
# - NATS_PASS                      (and NATS_USER, which must be SET but may be any name)
#
# Production ALSO requires, without a placeholder to refuse: DATABASE_URL (or API_DATABASE_URL),
# NATS_URL (or API_NATS_URL), and AUTH_URL — which must be HTTPS.
#
# Secrets the boot preflight does NOT check — you are on your own
# ---------------------------------------------------------------
# These carry placeholders too, but nothing refuses to start if you forget them. Treat this list
# as a manual checklist until the preflight grows to cover it.
#
# - NATS_SYS_PASS                  (the system credential; nothing first-party connects with it)
# - NATS_API_PASS                  (the four per-service broker identities. The preflight checks
# - NATS_ENGINE_PASS                only NATS_PASS, because that is the pair `@optimiq-voice/config`
# - NATS_MEDIAD_PASS                falls back to; a placeholder left in one of these fails at the
# - NATS_SIPD_PASS                  broker instead, as an authorization violation naming the user.)
# - API_DATABASE_URL               (embeds the Postgres password)
# - PBX_DATABASE_URL               (embeds the Postgres password)
# - CDR_DATABASE_URL               (embeds the Postgres password)
# - CDR_RECORDING_URL_SECRET       (signs recording and voicemail playback URLs)
# - SMTP_PASS / API_SMTP_AUTH_PASS
#
# Do not "tidy" the placeholder strings in the enforced list above. The literal values are what
# `PLACEHOLDER_SECRETS` in `packages/config/src/env-invariants.ts` matches; renaming one here
# without adding it there turns a loud startup failure into a deployment running on a public
# password.

# Web Settings (apps/web — the admin frontend)
# -------------------------------------------
# API_PROXY_ORIGIN and NEXT_PUBLIC_AUTH_BASE_URL are BUILD arguments, not runtime configuration:
# Next evaluates rewrites() and inlines NEXT_PUBLIC_* during `next build`, so changing either only
# takes effect on a rebuild of the image. They are read by compose.dev.yaml's `build.args`; the
# shipped image already defaults API_PROXY_ORIGIN to the `api` service.
#
# API_PROXY_ORIGIN must name the API's HTTP bridge (port 9876). Every /api/* request the browser
# makes is forwarded there by the web container, which is what keeps the better-auth session cookie
# first-party.
API_PROXY_ORIGIN=http://api:9876
# Leave empty unless the frontend is deployed apart from the API. Setting it makes the auth client
# call an absolute origin, which then also needs that origin in the API's trustedOrigins and
# cross-subdomain cookies configured.
NEXT_PUBLIC_AUTH_BASE_URL=
# The port the Next server listens on inside the container, and the host port `compose.yaml`
# publishes it on. `web` is the stack's ingress: it serves the app and proxies /api/auth/* and
# /api/v1/* to API_PROXY_ORIGIN.
WEB_PORT=3100

# Authentication (better-auth)
# ----------------------------
# AUTH_SECRET signs every session cookie and every one-time link the platform issues — email
# verification, password reset, organization invitations. Whoever holds it can mint a session for
# any user in any organization without touching the database, so it is the single highest-value
# secret in this file.
#
# Generate it. Do not think of one:
#
#   openssl rand -base64 32
#
# The preflight requires it in production, requires at least 32 characters, and refuses the exact
# placeholder below — but it cannot tell a generated secret from 32 characters of your keyboard.
# That part is on you. Rotating it signs every live session out, which is correct behaviour and
# worth knowing before you do it.
AUTH_SECRET=replace-with-a-generated-auth-secret
# The public HTTPS origin better-auth signs cookies and builds callback URLs against — the WEB app,
# not the API. It is deployment-specific and has no sensible placeholder, so it ships empty; set it
# or the API refuses to boot in production.
#
# It is also load-bearing beyond authentication: `isAuthSliceConfigured()` is
# `DATABASE_URL && AUTH_SECRET && AUTH_URL`, and the PBX and CDR areas mount only alongside the
# auth slice because their permission guard comes from it. Unset, the API serves no product
# surface at all.
AUTH_URL=

# API Server Settings
# ------------------
API_APP_URL=https://voice.example.com
API_ASTERISK_ARI_PROXY_URL=http://asterisk:8088
API_ASTERISK_ARI_SECRET=changeme
API_ASTERISK_ARI_USERNAME=ari
# The base database: better-auth's tables (`packages/db`). `@optimiq-voice/config` maps this onto
# the canonical DATABASE_URL, which is the name the code reads.
API_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/optimiq-voice
API_LOGS_FORMAT=json
API_LOGS_LEVEL=verbose
API_LOGS_TRANSPORT=none
API_NATS_URL=nats://nats:4222
API_OWNER_EMAIL=admin@optimiq-voice.local
API_OWNER_NAME=Admin User
API_OWNER_PASSWORD=changeme
API_ROOT_DOMAIN=optimiq-voice.local
API_SMTP_AUTH_PASS=secret
API_SMTP_AUTH_USER=postmaster@optimiq-voice.local
API_SMTP_HOST=your-smtp-server
API_SMTP_PORT=587
API_SMTP_SECURE=true
API_SMTP_SENDER="Optimiq Voice Info <info@optimiq-voice.local>"

# Telephony databases (the PBX and CDR bounded contexts)
# -----------------------------------------------------
# Separate databases from API_DATABASE_URL, deliberately. PBX_DATABASE_URL mounts extensions, ring
# groups, IVRs, queues, voicemail, routing, the media library and device provisioning;
# CDR_DATABASE_URL mounts call reporting and recording playback. Each area is skipped entirely when
# its variable is absent — silently, by design — so an incomplete stack looks healthy and serves
# nothing.
PBX_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/optimiq_pbx
CDR_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/optimiq_cdr
# The one object store. Call recordings, voicemail audio and every media-library upload (hold
# music, prompts, greetings) live under this root, and the media server must mount the SAME
# directory as ENGINE_MEDIA_OBJECT_ROOT — a file written anywhere else is a prompt with a row, a
# working preview in the admin UI, and silence on the call.
CDR_RECORDING_ROOT=/opt/optimiq-voice/recordings
# Signs recording and voicemail playback URLs; at least 32 characters. Without it the LISTS still
# work and minting a playback URL fails with a named error rather than falling back to an unsigned
# route. There is no default and there never will be one.
CDR_RECORDING_URL_SECRET=

# The object store
# ----------------
# `local` (the default, and what the shipped compose.yaml runs) means the root above IS the store.
# `s3` adds an S3-compatible DURABLE MIRROR — AWS S3, MinIO, Cloudflare R2, Ceph — so a replaced
# container does not take a month of recordings with it.
#
# It is a MIRROR, not a replacement, and that is a constraint rather than an unfinished migration.
# Asterisk opens prompts, hold music and voicemail audio off the shared volume, because ARI has no
# HTTP media scheme and a path is the only media reference the engine can hand it. So:
#
#   media library (hold music, prompts, greetings)  filesystem + mirror on upload
#   voicemail message audio                          filesystem + archive when the row is filed
#   call recordings                                  filesystem + archive when the row is finalized
#
# and the signed playback routes keep STREAMING through the API rather than redirecting to a
# presigned URL — the token means "read this row under the tenant's RLS scope", which a 302 cannot
# preserve. See apps/api/src/storage/object-store.ts for the whole picture.
#
# Leave STORAGE_DRIVER unset (or `local`) and nothing below matters. Set it to `s3` and S3_BUCKET
# becomes required at boot; a NODE_ENV=production process additionally refuses to start without
# S3_REGION, rather than silently falling back to the container filesystem.
STORAGE_DRIVER=local
# The bucket. Required when STORAGE_DRIVER=s3. No default, ever.
S3_BUCKET=
# Required by the SIGNER even for a store that has no regions: MinIO and Ceph accept and ignore
# `us-east-1`, Cloudflare R2 requires exactly `auto`.
S3_REGION=us-east-1
# Set for anything that is not AWS S3 itself: http://minio:9000, an R2 account URL, a Ceph gateway.
# Leave empty for AWS, where the SDK derives the endpoint from the region.
S3_ENDPOINT=
# Static credentials, set TOGETHER or not at all — half a pair is refused at boot. Left empty, the
# AWS SDK's default chain runs (environment, ~/.aws, container/instance metadata, web identity),
# which is how an IAM-role deployment should be configured and is better than a long-lived key here.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `http://host/bucket/key` rather than `http://bucket.host/key`. Required by MinIO and by any store
# reached over a bare hostname or an IP, because virtual-host addressing needs wildcard DNS.
# Defaults to true whenever S3_ENDPOINT is set and false otherwise; set it only to override that.
S3_FORCE_PATH_STYLE=
# An optional key prefix, for a deployment sharing one bucket across environments (`staging/`).
# Empty by default so the keys in the bucket are byte-identical to the paths under the root above —
# which is what makes an object recognisable in both places and a back-fill an `aws s3 sync`.
S3_PREFIX=

# Mail Delivery
# -------------
# These are the CANONICAL names. They are unprefixed because mail is a platform capability rather
# than an apps/api feature, and each one falls back to its legacy API_SMTP_* counterpart above, so
# a deployment that only sets those keeps working:
#
#   SMTP_HOST -> API_SMTP_HOST          SMTP_USER -> API_SMTP_AUTH_USER
#   SMTP_PORT -> API_SMTP_PORT          SMTP_PASS -> API_SMTP_AUTH_PASS
#   SMTP_SECURE -> API_SMTP_SECURE      MAIL_FROM -> API_SMTP_SENDER
#   MAIL_APP_URL -> API_APP_URL
#
# WITHOUT SMTP_HOST and MAIL_FROM the API renders every message — email verification, password
# reset, organization invitations, two-factor codes and voicemail notifications — and writes it to
# the log INSTEAD OF SENDING IT, one-time links included. That is a development affordance: a
# NODE_ENV=production process refuses to boot in that state rather than leaking links to a log
# aggregator.
#
# SMTP_SECURE is implicit TLS (SMTPS). Leave it unset and it is derived from the port: 465 is
# implicit TLS, anything else is STARTTLS.
SMTP_HOST=your-smtp-server
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=postmaster@optimiq-voice.local
SMTP_PASS=secret
# The envelope sender. A bare address or "Name <address>". No default: a guessed From address
# produces mail a receiving domain rejects for a reason nothing in the process can see.
MAIL_FROM="Optimiq Voice <no-reply@optimiq-voice.local>"
# Optional Reply-To, for a deployment whose MAIL_FROM is an unmonitored mailbox.
MAIL_REPLY_TO=
# Where a link inside a message points — the web app, not the API. Defaults to API_APP_URL.
MAIL_APP_URL=
# Connection/greeting/socket timeout for the relay, in milliseconds.
SMTP_TIMEOUT_MS=10000

# Message Broker (NATS)
# ---------------------
# The backbone carries every tenant's call events, the `routing-cache` dial plan, and
# `rpc.sip.v1.credential` — the request/reply that hands SIP password derivations to the SIP edge.
# Anything that can open a connection can read all of it and publish forged events onto it, for
# every tenant at once, so the broker requires authentication: `config/nats.conf` defines an
# OPTIMIQ account for the platform services and a separate $SYS account for operators.
#
# nats-server resolves all TEN of these out of its own environment; compose passes them through and
# no password is written into compose.yaml or the config file. Leave any of them unset and the
# broker REFUSES TO START rather than coming up open.
#
# FIVE IDENTITIES IN ONE ACCOUNT. The services share a subject space by design — the engine
# consumes what the API publishes — so they share an account, but they no longer share a
# CREDENTIAL. `config/nats.conf` gives each service user an allow-list built from what that service
# actually publishes and subscribes to, which is what makes the blast radius of a leaked password
# the size of one service rather than the size of the platform:
#
#   NATS_API_*      the control plane: three event families, three RPC responders, four KV buckets
#                   it owns and two it only reads.
#   NATS_ENGINE_*   the call path: the call and queue vocabulary, CDR legs, the media and routing
#                   RPCs, the call path's KV buckets. Cannot rewrite the dial plan.
#   NATS_MEDIAD_*   the media plane: four command subjects, two session events, one KV bucket.
#                   Cannot read `rpc.sip.v1.credential` — which matters, because this is the
#                   process with RTP sockets open to the internet.
#   NATS_SIPD_*     the SIP edge: registration events out, one credential request. Subscribes to
#                   no business subject at all and cannot forge a CDR leg.
#
# NATS_USER / NATS_PASS remain, as the OPERATOR identity: the `nats` CLI, the `pnpm verify:*`
# harnesses, and the fallback for any process not given its own pair. No service container is
# handed them any more. Use a DIFFERENT password for each of the five.
#
# NATS_URL is set alongside API_NATS_URL and is NOT redundant: the PBX and CDR areas parse
# `process.env` at their own boundary and read the unprefixed name, and the CDR area REQUIRES it.
NATS_URL=nats://nats:4222
NATS_USER=optimiq
NATS_PASS=changeme
NATS_API_USER=optimiq-api
NATS_API_PASS=changeme
NATS_ENGINE_USER=optimiq-engine
NATS_ENGINE_PASS=changeme
NATS_MEDIAD_USER=optimiq-mediad
NATS_MEDIAD_PASS=changeme
NATS_SIPD_USER=optimiq-sipd
NATS_SIPD_PASS=changeme
# The system credential: `$SYS.>` monitoring, `nats server report`, JetStream introspection.
# Deliberately NOT the same secret any service container holds.
NATS_SYS_USER=optimiq-sys
NATS_SYS_PASS=changeme

# Broker TLS. OPTIONAL AND OFF BY DEFAULT, on both sides.
#
# The broker's `tls` block lives in `config/nats-tls.conf`, an overlay selected by
# `compose.tls.yaml` — nats-server has no conditional in its config language, so a `tls` block in
# the base file would make the certificate paths as mandatory as the passwords and stop a fresh
# checkout from starting. Turning it on is therefore one compose file and one variable:
#
#   ./config/certs/generate-dev-certs.sh                 # development material, gitignored
#   docker compose -f compose.yaml -f compose.tls.yaml up nats -d
#   NATS_TLS_CA=/etc/nats/certs/ca.pem
#
# NATS_TLS_CA is a path to a CA bundle: setting it enables TLS and PINS that CA, which is the
# private-CA case (development, and any deployment that issues its own). NATS_TLS_ENABLED=true is
# the other case — TLS against the system trust store, for a certificate from a public issuer.
# Neither set is a plaintext connection. The URL scheme is not consulted, so NATS_URL may stay
# `nats://` either way.
NATS_TLS_CA=
NATS_TLS_ENABLED=

# Asterisk Settings
# ----------------
# ASTERISK_SIPPROXY_HOST must be an address every endpoint can reach; it is the one telephony
# address the boot preflight still refuses to leave at the `/* ... */` marker in production.
ASTERISK_ARI_PROXY_URL=http://asterisk:8088
ASTERISK_ARI_SECRET=changeme
ASTERISK_ARI_USERNAME=ari
ASTERISK_CODECS=g722,ulaw,alaw
ASTERISK_DTMF_MODE=auto_info
ASTERISK_RTP_PORT_END=20000
ASTERISK_RTP_PORT_START=10000
ASTERISK_SIPPROXY_HOST=/* Set to the IP address of the host */
ASTERISK_SIPPROXY_PORT=5060
ASTERISK_SIPPROXY_SECRET=changeme
ASTERISK_SIPPROXY_USERNAME=voice

# Call Engine (apps/engine)
# ------------------------
# The ARI application that orchestrates channels, walks routing artifacts and emits CDR legs.
# ENGINE_MEDIA_OBJECT_ROOT is Asterisk's container-side path for the object store above.
ENGINE_ARI_APP=optimiq-engine
ENGINE_PORT=4010
ENGINE_ROUTING_ENABLED=true
# Single-tenant development only. Unset in production, where an unattributable call is rejected
# rather than filed under a guess.
OPTIMIQ_DEV_ORG_ID=
OPTIMIQ_DEV_ENDPOINTS=false

# Database Security Configuration
# -----------------------------
# For production environments, we recommend using a managed database service
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

NODE_ENV=production
